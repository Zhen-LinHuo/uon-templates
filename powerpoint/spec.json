      "trent_turquoise": "37B4B0",
      "malaysia_sky_blue": "009BC1"
    },
    "neutral": {
      "white": "FFFFFF",
      "portland_stone": "FAF6EF",
      "portland_stone_40": "FDFBF9"
    },
    "usage_rules": [
      "Nottingham Blue dominant; supporting colours < half of colour make-up of an asset",
      "max two supporting colours per asset",
      "black removed from palette — use Nottingham Blue for body copy too",
      "neutral colours do not count toward the two-colour supporting limit"
    ]

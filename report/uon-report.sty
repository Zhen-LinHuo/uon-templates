% =====================================================================
% uon-report.sty — University of Nottingham simplified report
%
% For coursework, literature reviews, interim reports and other short
% documents: no thesis title page, no binding margin, sections instead
% of chapters, optional table of contents.
%
% Engine: LuaLaTeX.  Shares uon-brand.sty with the thesis template, so
% colours and fonts cannot drift apart.
%
% Options (passed through to the brand core):
%   [cjk] [body=times] [mono=maple]
% =====================================================================
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{uon-report}[2026/11/03 UoN report layout]

\DeclareOption*{\PassOptionsToPackage{\CurrentOption}{uon-brand}}
\ProcessOptions\relax

\RequirePackage{uon-brand}
\RequirePackage{etoolbox}
\RequirePackage{setspace}
\RequirePackage{geometry}
\RequirePackage{fancyhdr}
\RequirePackage{titlesec}
\RequirePackage[hidelinks]{hyperref}
\RequirePackage{cleveref}

% ---------------------------------------------------------------- geometry
% No binding margin is needed here; comfortable symmetric margins.
\geometry{a4paper, left=30mm, right=25mm, top=25mm, bottom=25mm}

% ---------------------------------------------------------------- spacing
\setstretch{1.15}          % switch to \onehalfspacing if a module demands 1.5
\setlength{\parindent}{0pt}
\setlength{\parskip}{0.5\baselineskip}

% ---------------------------------------------------------------- headers
\pagestyle{fancy}
\fancyhf{}
\renewcommand{\headrulewidth}{0pt}
\fancyfoot[C]{\thepage}
\fancypagestyle{plain}{\fancyhf{}\fancyfoot[C]{\thepage}%
  \renewcommand{\headrulewidth}{0pt}}

% ---------------------------------------------------------------- headings
\titleformat{\section}
  {\normalfont\sffamily\bfseries\Large\color{NottinghamBlue}}{\thesection}{0.7em}{}
\titleformat{\subsection}
  {\normalfont\sffamily\bfseries\large\color{NottinghamBlue}}{\thesubsection}{0.7em}{}

% ---------------------------------------------------------------- title block
% A compact title block rather than a full title page: a short report does
% not need one, and the brand still shows through the rule and the mark.
\makeatletter
% subtitle helper (\subtitle is not defined by article)
\providecommand{\@subtitle}{}
\newcommand{\subtitle}[1]{\def\@subtitle{#1}}

\newcommand{\uonreporttitle}{%
  \begin{center}
    \IfFileExists{uon-logo-blue.png}{%
      \includegraphics[width=42mm]{uon-logo-blue}\par\vspace{6mm}}{}%
    {\sffamily\bfseries\LARGE\color{NottinghamBlue}\@title\par}
    \vspace{3mm}
    \ifdefempty{\@subtitle}{}{\large\@subtitle\par\vspace{2mm}}
    {\normalsize\@author\par}
    {\normalsize\@date\par}
    \vspace{4mm}
    {\color{NottinghamBlue}\rule{\textwidth}{0.9pt}}
  \end{center}
  \vspace{4mm}
}
\makeatother

\graphicspath{{../common/assets/}{assets/}}

\endinput
